# Copie para .env e preencha com valores REAIS. O .env fica fora do repositorio (.gitignore).
# Em producao (EC2) estes valores sao injetados pelo pipeline/Terraform, nunca commitados.

# Banco de dados
DB_USER=ghuser
DB_PASSWORD=troque-por-uma-senha-forte
DB_NAME=guidinghand

# Grafana (porta de admin, restrita ao nosso IP)
GRAFANA_USER=admin
GRAFANA_PASSWORD=troque-por-uma-senha-forte

# Imagem da aplicacao (em producao: ghcr.io/<org>/<repo>:<tag>)
APP_IMAGE=guiding-hand-cloud:local
